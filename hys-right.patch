diff --git a/tests/hysteresisRightLiteral.test.js b/tests/hysteresisRightLiteral.test.js
new file mode 100644
index 0000000..639a1df
--- /dev/null
+++ b/tests/hysteresisRightLiteral.test.js
@@ -0,0 +1,45 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { hysteresisRightImplicitF, rightHysteresisCoefficients, solveRightHysteresisPoint, solveLeftHysteresisPoint, sonicImplicitF } from '../src/entities/surfaceImplicit/sonic.js'
+import { projectPointMinus, projectPointPlus } from '../src/entities/geometry/stateProjections.js'
+import { hysPlusMinusImplicit, hysPlusPlusImplicit } from '../src/entities/hysteresis/stateImplicit/index.js'
+
+const params = { b1: 8, b2: 0.2, c: 1 }
+test('H_R is the literal tangency polynomial even away from S_R', () => {
+  for (const z of [-3, -0.2, 0, 0.7, 4]) {
+    const { b1, b2, c } = params, t = 0.37, Y = -0.81
+    const expected = (1 + z ** 2) * (1 + 3 * (b1 + 1) * z ** 2 + b2 * (b1 + 1) ** 2 * z ** 3) * Y
+      + 2 * b1 * (1 + z ** 2) * (b2 - z + 2 * b2 * (b1 + 1) * z ** 2 - 3 * (b1 + 1) * z ** 3) * t
+      + 2 * c * (1 + b2 * z + (b1 + 1) * z ** 2 + 2 * b2 * (b1 + 1) * z ** 3 - 2 * (b1 + 1) * z ** 4)
+    assert.ok(Math.abs(hysteresisRightImplicitF(Y, t, z, params) - expected) < 1e-12 * Math.max(1, Math.abs(expected)))
+  }
+})
+
+test('right solver satisfies both equations and the existing projected eliminations', () => {
+  for (const z of [-10, -1, -0.2, 0, 0.2, 1, 10]) {
+    const p = solveRightHysteresisPoint(z, params)
+    assert.ok(p)
+    const { hT, hY, hC } = rightHysteresisCoefficients(z, params)
+    const scale = 1 + Math.abs(hT * p.t) + Math.abs(hY * p.Y) + Math.abs(hC)
+    assert.ok(Math.abs(hysteresisRightImplicitF(p.Y, p.t, z, params)) / scale < 1e-12)
+    assert.ok(Math.abs(sonicImplicitF(p.Y, p.t, z, params)) / scale < 1e-12)
+    for (const [project, implicit] of [[projectPointMinus, hysPlusMinusImplicit], [projectPointPlus, hysPlusPlusImplicit]]) {
+      const q = project(p, params)
+      assert.ok(Math.abs(implicit(q.u, q.v, params)) < 1e-4 * (1 + Math.abs(q.u) + Math.abs(q.v)) ** 3)
+    }
+  }
+})
+
+test('zero section is explicitly degenerate and preserves the finite branch limit', () => {
+  const p = solveRightHysteresisPoint(0, params)
+  assert.equal(p.systemDet, 0)
+  assert.equal(p.degenerateSection, true)
+  assert.ok(p.det !== 0)
+})
+
+test('left hysteresis retains its previous numerical result', () => {
+  assert.deepEqual(solveLeftHysteresisPoint(0, params), {
+    t: -0.09533898305084747, Y: 1.6949152542372883, z: 0, det: 37.76,
+    coords: [-0.09533898305084747, 1.6949152542372883, 0],
+  })
+})
